    "expected": {
      "project": "prefix\n\"\\uE000 \"\n"
    }
  },
  {
    "name": "cr-comment-after-blank",
    "source": "project: prefix\r\r# \"\\uE000\"\rnext: \"\\uE000\"",
    "expected": {
      "project": "prefix",
      "next": ""
    }
  },
  {
    "name": "cr-comment-ends-plain",
    "source": "project: prefix\r\r  # comment\r  \"\\uE000\"",
