[
  {
    "name": "cr-plain-continuation",
    "source": "project: prefix\r  \"\\uE000\"",
    "expected": {
      "project": "prefix \"\\uE000\""
    }
  },
  {
    "name": "cr-plain-blank",
    "source": "project: prefix\r\r  \"\\uE000\"",
    "expected": {
      "project": "prefix\n\"\\uE000\""
    }
  },
  {
    "name": "cr-plain-space-blanks",
    "source": "project: prefix\r  \r    \r  \"\\uE000uD800\\uE000\"",
    "expected": {
      "project": "prefix\n\n\"\\uE000uD800\\uE000\""
    }
  },
  {
    "name": "cr-plain-single-quote",
    "source": "project: prefix\r\r  '\\uE000'",
    "expected": {
      "project": "prefix\n'\\uE000'"
    }
  },
  {
    "name": "cr-plain-literal-sentinel",
