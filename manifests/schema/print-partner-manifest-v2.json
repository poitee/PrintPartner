{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://print-partner.dev/schema/print-partner-manifest-v2.json",
  "title": "Print Partner manifest v2",
  "type": "object",
  "required": ["format", "version"],
  "properties": {
    "format": { "const": "print-partner-manifest" },
    "version": { "const": 2 },
    "project": { "type": "string", "minLength": 1 },
    "plan": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "base_source_id": { "type": "string", "minLength": 1 },
        "addon_source_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    },
    "option_groups": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/optionGroup" }
    },
    "parts": {
      "type": "array",
      "items": { "$ref": "#/$defs/partRule" }
    },
    "addons": {
      "type": "array",
      "items": { "$ref": "#/$defs/addon" }
    },
    "selections": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "slots": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/slot" }
    },
    "choice_tree": {
      "type": "array",
      "items": { "type": "object" }
    },
    "variant_dimensions": {
      "type": "object",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "number" }
          ]
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "match": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["match"],
          "properties": {
            "match": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    },
    "source": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["github", "local", "printables", "makerworld", "self", "archive"]
        },
        "url": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "variant": {
      "type": "object",
      "required": ["id", "parts"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "parts": {
          "type": "array",
          "items": { "$ref": "#/$defs/match" }
        },
        "excludes": {
          "type": "array",
          "items": { "$ref": "#/$defs/match" }
        }
      },
      "additionalProperties": false
    },
    "optionGroup": {
      "type": "object",
      "required": ["rule"],
      "properties": {
        "rule": { "enum": ["pick_one", "pick_any", "pick_n"] },
        "label": { "type": "string" },
        "min": { "type": "integer", "minimum": 0 },
        "max": { "type": "integer", "minimum": 0 },
        "variants": {
          "type": "array",
          "items": { "$ref": "#/$defs/variant" }
        },
        "parts": {
          "type": "array",
          "items": { "$ref": "#/$defs/match" }
        }
      },
      "anyOf": [
        { "required": ["parts"] },
        { "required": ["variants"] }
      ],
      "additionalProperties": false
    },
    "partRule": {
      "type": "object",
      "required": ["match"],
      "properties": {
        "match": { "type": "string", "minLength": 1 },
        "requirement": { "enum": ["required", "optional", "recommended"] },
        "change": { "enum": ["base", "added", "replacement"] },
        "replaces": { "type": "string", "minLength": 1 },
        "default_included": { "type": "boolean" },
        "option_group": { "type": "string", "minLength": 1 },
        "slot": { "type": "string", "minLength": 1 },
        "replaces_slot": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "addon": {
      "type": "object",
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "project": { "type": "string", "minLength": 1 },
        "parts": {
          "type": "array",
          "items": { "$ref": "#/$defs/partRule" }
        }
      },
      "additionalProperties": false
    },
    "slot": {
      "type": "object",
      "properties": {
        "label": { "type": "string" },
        "default_group": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
