{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://print-partner.dev/schema/print-partner-manifest-v1.json",
  "title": "Print Partner manifest v1",
  "type": "object",
  "required": ["format", "version"],
  "properties": {
    "format": { "const": "print-partner-manifest" },
    "version": { "const": 1 },
    "project": { "type": "string", "minLength": 1 },
    "option_groups": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/optionGroup" }
    },
    "parts": {
      "type": "array",
      "items": { "$ref": "#/$defs/partRule" }
    },
    "slots": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/slot" }
    },
    "choice_tree": {
      "type": "array",
      "items": { "type": "object" }
    },
    "addons": { "type": "array" }
  },
  "additionalProperties": false,
  "$defs": {
    "match": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["match"],
          "properties": {
            "match": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    },
    "variant": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "parts": {
          "type": "array",
          "items": { "$ref": "#/$defs/match" }
        },
        "excludes": {
          "type": "array",
          "items": { "$ref": "#/$defs/match" }
        }
      },
      "additionalProperties": false
    },
    "optionGroup": {
      "type": "object",
      "required": ["rule", "parts"],
      "properties": {
        "rule": { "enum": ["pick_one", "pick_any", "pick_n"] },
        "min": { "type": "integer", "minimum": 0 },
        "max": { "type": "integer", "minimum": 0 },
        "label": { "type": "string" },
        "parts": {
          "type": "array",
          "items": { "$ref": "#/$defs/match" }
        },
        "variants": {
          "type": "array",
          "items": { "$ref": "#/$defs/variant" }
        }
      },
      "additionalProperties": false
    },
    "partRule": {
      "type": "object",
      "required": ["match"],
      "properties": {
        "match": { "type": "string", "minLength": 1 },
        "requirement": { "enum": ["required", "optional", "recommended"] },
        "change": { "enum": ["base", "added", "replacement"] },
        "replaces": { "type": "string", "minLength": 1 },
        "default_included": { "type": "boolean" },
        "option_group": { "type": "string", "minLength": 1 },
        "slot": { "type": "string", "minLength": 1 },
        "replaces_slot": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "slot": {
      "type": "object",
      "properties": {
        "label": { "type": "string" },
        "default_group": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
