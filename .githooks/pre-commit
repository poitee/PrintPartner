#!/usr/bin/env bash
# Opt-in checks on staged changes. Enable with `just hooks`.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

git diff --cached --check
python3 -B scripts/check-large-files.py
if [ -n "$(git diff --cached --name-only --diff-filter=ACMR -- 'rust/*.rs')" ]; then
  # Format the staged snapshot, not the working tree, so the result matches the commit.
  snapshot="$(mktemp -d)"
  trap 'rm -rf "$snapshot"' EXIT
  git ls-files -z -- rust | git checkout-index --ignore-skip-worktree-bits -z --stdin --prefix="$snapshot/"
  cargo fmt --manifest-path "$snapshot/rust/Cargo.toml" --all --check
fi
