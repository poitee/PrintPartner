#!/usr/bin/env bash
# Opt-in checks on staged changes. Enable with `just hooks`.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

git diff --cached --check
python3 -B scripts/check-large-files.py
if git diff --cached --name-only --diff-filter=ACMR -- 'rust/*.rs' | grep -q .; then
  cargo fmt --manifest-path rust/Cargo.toml --all --check
fi
