{
  "name": "@print-partner/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build --manifest",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:browser:filename-grouping": "node test/browser/filename-grouping.isolated.mjs",
    "test:browser:part-color": "node test/browser/part-color.isolated.mjs",
    "test:browser": "node --experimental-vm-modules --test test/isolated-startup.test.mjs && node test/browser/skip-link.browser.mjs && node test/browser/checkoff-sheet-dark.browser.mjs && node test/browser/filament-preview-colors.browser.mjs && node test/browser/stl-orientation.browser.mjs && node test/browser/thumbnail-recovery.browser.mjs && node test/browser/filename-grouping.isolated.mjs && node test/browser/part-color.isolated.mjs && node test/browser/account-password.isolated.mjs",
    "test:bundles": "node --test test/route-bundles.test.mjs && node scripts/route-bundles.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@print-partner/contracts": "*",
    "@print-partner/domain": "*",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sentry/react": "^10.76.2",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-query": "^5.104.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "fastify": "^5.12.7",
    "fflate": "^0.8.3",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.64.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "description": "Print Partner React SPA — desk loop UI, spine navigation, plate export, and Progress checkoff."
}
