{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "draft_id": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "state": {
      "type": "string",
      "enum": [
        "open",
        "abandoned",
        "consumed"
      ]
    },
    "lifecycle_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "snapshot_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base": {
      "type": "object",
      "properties": {
        "revision_id": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "plan_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "revision_id",
        "plan_version"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "draft_id",
    "state",
    "lifecycle_version",
    "snapshot_digest",
    "base"
  ],
  "additionalProperties": false
}
