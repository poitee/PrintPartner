{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "optional": {
      "type": "string"
    },
    "nullable": {
      "type": [
        "string",
        "null"
      ]
    },
    "defaulted": {
      "default": 3,
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "mode": {
      "type": "string",
      "enum": [
        "read",
        "write"
      ]
    },
    "integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4
    }
  },
  "required": [
    "nullable",
    "mode",
    "integer",
    "date",
    "text"
  ]
}
