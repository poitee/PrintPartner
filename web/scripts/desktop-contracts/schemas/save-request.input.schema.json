{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "expected_base": {
      "type": "object",
      "properties": {
        "revision_id": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "plan_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "revision_id",
        "plan_version"
      ],
      "additionalProperties": false
    },
    "expected_draft": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "draft_id": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "state": {
              "type": "string",
              "enum": [
                "open",
                "abandoned",
                "consumed"
              ]
            },
            "lifecycle_version": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "snapshot_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "base": {
              "type": "object",
              "properties": {
                "revision_id": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "plan_version": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "revision_id",
                "plan_version"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "draft_id",
            "state",
            "lifecycle_version",
            "snapshot_digest",
            "base"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "remap_checkoff_links": {
      "type": "boolean"
    },
    "decisions": {
      "minItems": 1,
      "maxItems": 10000,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "set_included"
              },
              "target": {
                "type": "object",
                "properties": {
                  "part_key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "relative_path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "source_layer": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 1000
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "part_key",
                  "relative_path",
                  "source_layer"
                ],
                "additionalProperties": false
              },
              "value": {
                "type": "boolean"
              }
            },
            "required": [
              "kind",
              "target",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "set_quantity_override"
              },
              "target": {
                "type": "object",
                "properties": {
                  "part_key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "relative_path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "source_layer": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 1000
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "part_key",
                  "relative_path",
                  "source_layer"
                ],
                "additionalProperties": false
              },
              "value": {
                "anyOf": [
                  {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 10000
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "kind",
              "target",
              "value"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "expected_base",
    "expected_draft",
    "remap_checkoff_links",
    "decisions"
  ],
  "additionalProperties": false
}
