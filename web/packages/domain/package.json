{
  "name": "@print-partner/domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/current/index.js",
  "types": "./dist/current/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/current/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/current/index.js"
    },
    "./import-rules": {
      "types": "./dist/current/import-rules.d.ts",
      "development": "./src/import-rules.ts",
      "import": "./dist/current/import-rules.js"
    },
    "./parts-grouping": {
      "types": "./dist/current/parts-grouping.d.ts",
      "development": "./src/parts-grouping.ts",
      "import": "./dist/current/parts-grouping.js"
    },
    "./sliced-object-matching": {
      "types": "./dist/current/sliced-object-matching.d.ts",
      "development": "./src/sliced-object-matching.ts",
      "import": "./dist/current/sliced-object-matching.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/atomic-package-build.mjs --project tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@print-partner/contracts": "*",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "description": "Framework-agnostic Print Partner domain logic (plans, packing, export paths)."
}
