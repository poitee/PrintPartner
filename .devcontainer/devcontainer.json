{
  "name": "Print Partner Rust and React",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "remoteUser": "developer",
  "userEnvProbe": "none",
  "updateRemoteUserUID": true,
  "workspaceFolder": "/workspaces/PrintPartner",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/PrintPartner,type=bind",
  "forwardPorts": [],
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "shutdownAction": "stopContainer"
}
