{
  "scenario": "unknown-key-rejected",
  "description": "confirm_apply and dismiss_proposed_action reject an action_id that was never proposed; nothing is applied",
  "steps": [
    {
      "request": {
        "method": "tools/call",
        "params": {
          "name": "propose_add_custom_filament",
          "arguments": {
            "display_name": "Galaxy Black",
            "hex": "#1a1a1a",
            "product_line": "PLA Basic"
          }
        }
      },
      "response": {
        "isError": false,
        "content": [
          {
            "type": "text",
            "json": {
              "status": "proposed",
              "note": "Not applied yet — user must confirm via Apply in the UI.",
              "action": {
                "id": "<action-id-1>",
                "type": "propose_add_custom_filament",
                "plan_id": 0,
                "label": "add custom filament Galaxy Black",
                "summary": "Add a named external filament without stock tracking.",
                "params": {
                  "display_name": "Galaxy Black",
                  "hex": "#1a1a1a",
                  "product_line": "PLA Basic"
                }
              }
            }
          }
        ]
      }
    },
    {
      "request": {
        "method": "tools/call",
        "params": {
          "name": "confirm_apply",
          "arguments": {
            "action_id": "00000000-0000-4000-8000-000000000000"
          }
        }
      },
      "response": {
        "isError": true,
        "content": [
          {
            "type": "text",
            "json": {
              "ok": false,
              "error": "Unknown, in-flight, or already applied/dismissed action_id",
              "action_id": "00000000-0000-4000-8000-000000000000"
            }
          }
        ]
      }
    },
    {
      "request": {
        "method": "tools/call",
        "params": {
          "name": "dismiss_proposed_action",
          "arguments": {
            "action_id": "00000000-0000-4000-8000-000000000000"
          }
        }
      },
      "response": {
        "isError": false,
        "content": [
          {
            "type": "text",
            "json": {
              "ok": false,
              "action_id": "00000000-0000-4000-8000-000000000000"
            }
          }
        ]
      }
    },
    {
      "request": {
        "method": "tools/call",
        "params": {
          "name": "list_pending_actions",
          "arguments": {}
        }
      },
      "response": {
        "isError": false,
        "content": [
          {
            "type": "text",
            "json": {
              "actions": [
                {
                  "id": "<action-id-1>",
                  "type": "propose_add_custom_filament",
                  "plan_id": 0,
                  "label": "add custom filament Galaxy Black",
                  "summary": "Add a named external filament without stock tracking.",
                  "params": {
                    "display_name": "Galaxy Black",
                    "hex": "#1a1a1a",
                    "product_line": "PLA Basic"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  ],
  "final_state": {
    "pending_action_ids": [
      "<action-id-1>"
    ],
    "custom_filaments": []
  }
}
