# Private invite host. Copy to hosted-planning.env and fill in the secrets.
# Do not commit hosted-planning.env.
#
#   docker compose --env-file hosted-planning.env -f docker-compose.hosted.yml up -d
#
# Leave SAAS_ALLOW_ANONYMOUS unset. Do not set DATABASE_URL, POSTGRES_EXPERIMENTAL,
# or S3_BUCKET. Production hosted planning refuses anonymous access.

SESSION_SECRET=
ALLOWED_ORIGINS=https://plan.example.com
REGISTRATION_OPEN=1
PP_BIND_ADDRESS=127.0.0.1

# Optional. Defaults to the compose file pin.
# PRINT_PARTNER_VERSION=

# Optional. Required only if you send password-reset mail.
# APP_PUBLIC_URL=https://plan.example.com
# SMTP_HOST=
# SMTP_FROM=

# Optional GitHub OAuth for invite accounts.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=https://plan.example.com/auth/callback
